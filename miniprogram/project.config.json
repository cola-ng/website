{
  "description": "开朗英语微信小程序",
  "projectname": "colang-miniprogram",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "libVersion": "3.7.0",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      }
    ]
  }
}
