page {
  background: #f7f5f2;
  color: #292622;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.65;
}
view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}
button {
  font-size: 29rpx;
  line-height: 1.5;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: #ede9e3;
  color: #4b4138;
  margin: 0;
  font-weight: 600;
}
button::after {
  border: 0;
}
button[disabled] {
  background: #edeae6;
  color: #98918a;
}
button.primary {
  background: #c45516;
  color: white;
}
button.primary[disabled] {
  background: #e3d5ca;
  color: #8e7b6e;
}
button.danger {
  background: #fff0ef;
  color: #ad302b;
}
button.small {
  font-size: 25rpx;
  padding: 14rpx 22rpx;
}
button.ghost {
  background: #fff4e8;
  color: #a94712;
}
input,
textarea {
  background: #f7f5f2;
  border: 2rpx solid #e9e2d9;
  border-radius: 18rpx;
  font-size: 30rpx;
  padding: 22rpx;
  width: 100%;
}
input {
  height: 92rpx;
}
textarea {
  min-height: 180rpx;
}
image {
  max-width: 100%;
}
.page {
  padding: 32rpx 30rpx 70rpx;
  padding-bottom: calc(70rpx + env(safe-area-inset-bottom));
}
.card {
  background: #fff;
  border: 2rpx solid #eee8e0;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.hero {
  padding: 40rpx 34rpx;
  background: #fff0de;
  border-color: #f2d5b2;
}
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #a94712;
  font-weight: 700;
}
.title {
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 750;
  margin: 12rpx 0 20rpx;
}
.heading {
  font-size: 34rpx;
  font-weight: 700;
  margin: 14rpx 0 22rpx;
}
.subheading {
  font-size: 30rpx;
  font-weight: 650;
  margin: 14rpx 0;
}
.muted {
  font-size: 27rpx;
  color: #77716b;
}
.english {
  font-size: 34rpx;
  line-height: 1.6;
  word-break: break-word;
}
.body {
  white-space: pre-wrap;
  word-break: break-word;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.row input {
  flex: 1;
  min-width: 0;
}
.row button {
  flex-shrink: 0;
}
.wrap {
  flex-wrap: wrap;
}
.actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin: 24rpx 0 6rpx;
}
.actions button {
  flex: 1;
  min-width: 180rpx;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.grid .card {
  margin: 0;
}
.metric {
  font-size: 44rpx;
  font-weight: 750;
  color: #a94712;
}
.label {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  margin: 26rpx 0 12rpx;
}
.empty {
  text-align: center;
  padding: 46rpx 22rpx;
  color: #77716b;
}
.tag {
  display: inline-block;
  font-size: 23rpx;
  border-radius: 10rpx;
  padding: 5rpx 14rpx;
  background: #fff1e1;
  color: #9d4716;
  margin: 8rpx 12rpx 8rpx 0;
}
.list-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0ece6;
}
.list-row:last-child {
  border: 0;
}
.menu {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f0ece6;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.menu:last-child {
  border: 0;
}
.arrow {
  color: #a59c92;
}
.tabs {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 0 0 26rpx;
}
.tabs button {
  font-size: 27rpx;
  padding: 16rpx 24rpx;
}
.tabs .selected {
  background: #c45516;
  color: #fff;
}
.spacer {
  height: 24rpx;
}
.progress {
  height: 12rpx;
  background: #eee8de;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 24rpx 0;
}
.progress-fill {
  height: 100%;
  background: #ce6427;
}
.score {
  font-size: 70rpx;
  font-weight: 750;
  color: #a94712;
}
.recording {
  background: #af332a !important;
  color: #fff !important;
}
.feedback {
  margin: 16rpx 0;
  padding: 18rpx;
  background: #fff7ec;
  border-radius: 16rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 22rpx;
  margin: 12rpx 12rpx 0 0;
  border-radius: 16rpx;
  background: #f2ede6;
  color: #665445;
  font-size: 27rpx;
}
.field-help {
  font-size: 25rpx;
  color: #77716b;
  margin-top: 10rpx;
}
