<view class="page">
  <view class="title">个人资料与密码</view>
  <view wx:if="{{!user}}" class="card empty">
    请先登录账户。
    <view class="actions">
      <button class="primary" bindtap="login">去登录</button>
    </view>
  </view>
  <block wx:else>
    <page-status
      loading="{{loading}}"
      error="{{error}}"
      notice="{{notice}}"
      bindretry="retry"
    />
    <view class="card">
      <view class="heading">个人资料</view>
      <text class="label">昵称</text>
      <input
        value="{{name}}"
        data-field="name"
        bindinput="input"
        maxlength="64"
      />
      <text class="label">唯一用户标识 Handle</text>
      <input
        value="{{handle}}"
        data-field="handle"
        bindinput="input"
        maxlength="32"
      />
      <view class="field-help">
        3–32 位，字母开头，可含字母、数字、下划线和短横线。
      </view>
      <text class="label">手机号（选填）</text>
      <input
        value="{{phone}}"
        data-field="phone"
        bindinput="input"
        maxlength="32"
      />
      <view class="actions">
        <button
          class="primary"
          disabled="{{busy || loading}}"
          loading="{{busy}}"
          bindtap="save"
        >
          保存资料
        </button>
      </view>
    </view>
    <view class="card">
      <view class="heading">{{hasPassword ? '修改密码' : '设置密码'}}</view>
      <block wx:if="{{hasPassword}}">
        <text class="label">当前密码</text>
        <input
          password
          value="{{oldPassword}}"
          data-field="oldPassword"
          bindinput="input"
          maxlength="128"
        />
      </block>
      <text class="label">新密码</text>
      <input
        password
        value="{{newPassword}}"
        data-field="newPassword"
        bindinput="input"
        maxlength="128"
        placeholder="至少 8 位"
      />
      <view class="actions">
        <button disabled="{{busy || loading}}" bindtap="password">
          更新密码
        </button>
      </view>
    </view>
  </block>
</view>
