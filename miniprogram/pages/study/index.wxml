<view class="page">
  <view class="eyebrow">A LITTLE EVERY DAY</view>
  <view class="title">今天也要，开口说。</view>
  <view class="muted">按自己的节奏，让英语成为习惯。</view>
  <view class="spacer" />
  <page-status loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <view class="card hero" data-url="/pages/chat/index" bindtap="open">
    <view class="heading">💬 你的 AI 英语伙伴</view>
    <view>从问候开始，自由聊天或选择情景。</view>
    <view class="tag">文字 · 语音 · 双语反馈</view>
  </view>
  <view class="grid">
    <view class="card" data-url="/pages/read/index" bindtap="open">
      <view class="heading">🎙 跟读</view>
      <view class="muted">听原音，练表达</view>
    </view>
    <view class="card" data-url="/pages/stages/index" bindtap="open">
      <view class="heading">🌍 场景</view>
      <view class="muted">在生活中学英语</view>
    </view>
  </view>
  <view class="heading">复习，让记忆更牢固</view>
  <view class="card">
    <view class="menu" data-url="/pages/review/index" bindtap="open">
      <view>
        ✦ 智能复习
        <view class="muted">
          {{stats ? stats.total + ' 项待复习' : '按实际薄弱项安排练习'}}
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view
      class="menu"
      data-url="/pages/review/index?type=meaning"
      bindtap="open"
    >
      词义理解
      <text class="arrow">›</text>
    </view>
    <view
      class="menu"
      data-url="/pages/review/index?type=spelling"
      bindtap="open"
    >
      拼写练习
      <text class="arrow">›</text>
    </view>
    <view
      class="menu"
      data-url="/pages/review/index?type=recognition"
      bindtap="open"
    >
      单词识别
      <text class="arrow">›</text>
    </view>
    <view
      class="menu"
      data-url="/pages/review/index?type=pronunciation"
      bindtap="open"
    >
      发音练习
      <text class="arrow">›</text>
    </view>
    <view
      class="menu"
      data-url="/pages/review/index?type=phrase"
      bindtap="open"
    >
      短语用法
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="card">
    <view
      class="menu"
      data-url="/pages/collection/index?type=vocabulary"
      bindtap="open"
    >
      我的生词本
      <text class="arrow">›</text>
    </view>
    <view
      class="menu"
      data-url="/pages/collection/index?type=favorites"
      bindtap="open"
    >
      我的收藏
      <text class="arrow">›</text>
    </view>
  </view>
</view>
