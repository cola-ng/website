# Server configuration
BIND_ADDR=0.0.0.0:8119
STATIC_DIR=front/dist

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# JWT configuration: generate a random secret of at least 32 bytes before starting.
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_TTL_SECONDS=604800

# Third-party login: exact external origin, without a path. Secrets stay on the server.
# Local preview forwards /api to the backend on port 8119.
PUBLIC_BASE_URL=http://127.0.0.1:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register these exact URLs with the corresponding provider:
# ${PUBLIC_BASE_URL}/api/auth/github/callback
# ${PUBLIC_BASE_URL}/api/auth/google/callback

# Platform AI: available only to paid, valid subscriptions. Personal user keys
# are configured per account and do not require these platform credentials.
# Set credentials on the server only. Model IDs/endpoints must
# be enabled for that provider account. Conversation replies use streaming.
AI_PROVIDER_DEFAULT=zhipu
ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4-flash
